{
  "name": "@hivecommons/promptargs",
  "version": "0.10.0",
  "description": "Template arguments for AI prompts — variable substitution for Claude Code, Copilot, Goose, Bob, and more",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "promptargs": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node -e \"const fs = require('node:fs'); fs.copyFileSync('src/ui.html', 'dist/ui.html'); fs.copyFileSync('node_modules/mustache/mustache.mjs', 'dist/mustache.mjs')\"",
    "dev": "tsc --watch",
    "test": "node scripts/run-tests.mjs",
    "test:coverage": "node scripts/run-tests.mjs --coverage",
    "lint": "tsc --noEmit",
    "test:mutation": "stryker run"
  },
  "keywords": [
    "prompt",
    "template",
    "ai",
    "claude",
    "copilot",
    "args",
    "cli",
    "claude-code",
    "goose",
    "bob",
    "agent-skills",
    "prompt-templates"
  ],
  "author": "hivecommons",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hivecommons/promptargs.git"
  },
  "bugs": {
    "url": "https://github.com/hivecommons/promptargs/issues"
  },
  "homepage": "https://github.com/hivecommons/promptargs#readme",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "!dist/**/*.test.js.map",
    "!dist/**/*.test.d.ts",
    "!dist/ui-harness.*",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "mustache": "^4.2.0"
  },
  "overrides": {
    "@stryker-mutator/core": {
      "minimatch": "^11.0.1",
      "typed-rest-client": {
        "qs": "^6.17.1"
      }
    }
  }
}
